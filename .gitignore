# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Bundled 32-bit interpreter needs its compiled extension modules
!src/hamilton_venus/_com32_py32/**/*.pyd

# hatch-vcs writes this at build time
src/hamilton_venus/_version.py

# IDE
.vs/

# AI
.abacusai/

# Local development
local/
.local/

# WebView2 runtime user-data cache and Windows folder metadata
*.exe.WebView2/
desktop.ini

# Smoke test run logs
logs/
*.log

# VENUS executor temporary artifacts
sdk_method_structure/Library/Executors/~Hx*
.vscode/settings.json

# Tools (tools/<app>): per-run build output and runtime state written by the apps, not source
**/shell*/bin/
**/shell*/obj/
**/shell*/publish/
tools/*/backend/data/

# Written by the installer for this PC
.mcp.json
Start MCP Spoke.bat
Start MCP Hub.bat
tools/*/appsettings.local.json
/mcp_scripts/

# Debug symbols
*.pdb
