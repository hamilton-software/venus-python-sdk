// {{{ 5 "_CheckForError" "Begin"
private function _CheckForError( variable i_intReturn ) void {
// }} ""
private variable l_strDescription;
// {{ 5 "_CheckForError" "InitLocals"
// }} ""
// {{ 716 1 0 "412d578d_fa98_4661_9e00f4ed5fbe50cb" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (i_intReturn == 0)
{
// }} ""
// {{{ 717 1 0 "8ec5f4a1_f14a_4b7f_8bcc3c248912808c" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return;
// }} ""
// {{ 718 1 0 "412d578d_fa98_4661_9e00f4ed5fbe50cb" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{ 719 1 0 "ea70f892_5e8b_414c_b12990ce1bcceb29" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strDescription = Translate("Unknown Error");
// }} ""
{
   if(i_intReturn == 1) l_strDescription = "An internal range error has occur.\n\nCheck the firmware version.";
   else if (i_intReturn == 2) l_strDescription = "The specified ML_Star or USB node is not initialized.\n\nA command was send before CreateStarDevice() or CreateUsbDevice() was called.";
   else if (i_intReturn == 3) l_strDescription = "The USB connection is broken.\n\nInsert the USB cable and switch ON the shaker.\nThe first heater - shaker CAN node must set to 0 (and connected with the USB cable).";
   else if (i_intReturn == 4) l_strDescription = "Communication to the needed CAN node is not possible.\n\nConfirm that the heater - shaker CAN node is set correctly.\n\nML_STAR node 1 must be set to 5 on heater - shaker.\nML_STAR node 2 must be set to 6 on heater - shaker.\n\nOn USB, the first heater - shaker CAN node must set to 0 (and connected with the USB cable).\nAll additional USB CAN nodes must be set between 1 – 7.";
   else if (i_intReturn == 5) l_strDescription = "No communication to the EEPROM.";
   else if (i_intReturn == 6) l_strDescription = "An unknown command was send to the heater - shaker.\n\nMethod contains a call of SendFirmwareCommand with incorrect command.\nCheck firmware version.";
   else if (i_intReturn == 7) l_strDescription = "A command with an incorrect parameter was send to the heater - shaker.\n\nMethod contains a call of SendFirmwareCommand with incorrect command parameter.\nCheck the firmware version.";
   else if (i_intReturn == 8) l_strDescription = "An parameter is out of the defined range.\n\nOpen method and set the parameter correct.";
   else if (i_intReturn == 9) l_strDescription = "Voltage outside permitted range.\n\nHardware is not working properly.";
   else if (i_intReturn == 10) l_strDescription = "Stop command was send to the heater - shaker.\n\nAll running commands are stopped and returns this error.";
   else if (i_intReturn == 11) l_strDescription = "A command was send to an unknown system address (node).\n\nCorrect the used method.";
   else if (i_intReturn == 12) l_strDescription = "Multiple commands to the same node are not allowed.\n\nCorrect the used method.";
   else if (i_intReturn == 13) l_strDescription = "Shaker initialize error.\n\nHardware not working properly.";
   else if (i_intReturn == 14) l_strDescription = "Plate lock drive not initialized.\n\nA command was send before shaker was initialized.\n\nCall function CreateStarDevice() or CreateUsbDevice().";
   else if (i_intReturn == 15) l_strDescription = "Shaker drive step loss.\n\nVerify that there is no crash and repeat the command.";
   else if (i_intReturn == 16) l_strDescription = "Shaker was not started with timeout.\n\nIt isn't allowed to call the function WaitForShaker if the shaker was started infinite.\n\nCorrect the used method.";
   else if (i_intReturn == 17) l_strDescription = "Plate lock initialize error.\n\nHardware not working properly.";
   else if (i_intReturn == 18) l_strDescription = "Plate lock drive not initialized.\n\nA command was send before plate lock was initialized.\nDuring open / close of plate lock an step loss is occured.\n\nCall function CreateStarDevice() or CreateUsbDevice().";
   else if (i_intReturn == 19) l_strDescription = "Plate lock drive step loss.\n\nVerify that there is no collision and repeat the command.";
   else if (i_intReturn == 20) l_strDescription = "The temperature controlling is not started.\n\nA WaitForTempCtrl command was start before StartTempCtlr was called.\n\nCorrect the used method.";
   else if (i_intReturn == 21) l_strDescription = "Time elapsed before temperature was in the defined controlling range.\n\nSupervision time out in StartTempCtrl to short or temperature controller problems.";
   else if (i_intReturn == 22) l_strDescription = "The temperature was or is out of the defined temperature control range.\n\nVerify that the hardware (heater) works correctly and the used temperature range setting is correct.";
   else if (i_intReturn == 23) l_strDescription = "The temperature was out of the defined security control range.\n\nVerify that the hardware (heater) works correctly and the used temperature range setting is correct.\n\nNote:\nIf the temperature is out of the security range, heating is switched off.";
   else if (i_intReturn == 24) l_strDescription = "Temperature different between the sensors is to high.\n\nHardware must be checked.";
   else if (i_intReturn == 25) l_strDescription = "A command is not responding in the defined time.\n\nVerify that the shaker works correctly and the communication cable is plugged in.";
   else if (i_intReturn == 26) l_strDescription = "Unknown error code in firmware result string received.\n\nA command has responded with an error that is not in the list of expected errors.";
   else if (i_intReturn == 27) l_strDescription = "Check if the input parameter has failed.\n\nChange the parameter to the correct type.";
   else if (i_intReturn == 28) l_strDescription = "Check if the input parameter has failed.\n\nChange the parameter to the correct type.";
   else if (i_intReturn == 29) l_strDescription = "Check if the input parameter has failed.\n\nChange the parameter to the correct type.";
   else if (i_intReturn == 30) l_strDescription = "The given ML_Star or USB node is not available.\n\nCheck the settings of the heater - shaker hardware and verify that the CAN node is set correctly.";
   else if (i_intReturn == 31) l_strDescription = "Firmware response string with an unknown format received.\n\nA command has responded with an format that can't be interpreted.";
   else if (i_intReturn == 32) l_strDescription = "A command with an incorrect parameter length was sent to the heater - shaker.\n\nMethod contains a call of SendFirmwareCommand with incorrect command parameter.\nCheck the firmware version.";
}
// {{{ 721 1 0 "1e73c18d_8f10_4633_9c175ba6c97d006b" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
ErrRaise(i_intReturn, l_strDescription);
// }} ""
// {{{ 5 "_CheckForError" "End"
}
// }} ""
