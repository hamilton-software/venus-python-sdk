// {{{ 5 "GetZOrigin" "Begin"
function GetZOrigin( device & Device, variable i_strLabware ) variable {
// }} ""
private variable l_fltZOrigin;
// {{ 5 "GetZOrigin" "InitLocals"
// }} ""
// {{ 1241 1 0 "3c2c6409_0cff_41f3_abcc745312392b14" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltZOrigin = 0.0;
// }} ""
{
   object objRackDataParams;
   object objDeckLayout;
   object objLabware;
   object objRack4;
   
   objRackDataParams.CreateObject("HXPARAMSLib.HxPars");
   objDeckLayout = Device.GetDeckLayoutObject();
   objLabware = objDeckLayout.Labware(i_strLabware);
   objLabware.GetObject("IRectRack4", objRack4);
   objRack4.GetRackData(objRackDataParams);

   onerror goto HandleLabwareError;

   l_fltZOrigin = objRack4.RackBase();

   onerror goto 0;

   HandleLabwareError :
   {
      objRackDataParams.ReleaseObject();
      objDeckLayout.ReleaseObject();
      objLabware.ReleaseObject();
      objRack4.ReleaseObject();
   }
}
// {{{ 1243 1 0 "ce49c872_937a_4990_945e25b8aeb28df0" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (l_fltZOrigin);
// }} ""
// {{{ 5 "GetZOrigin" "End"
}
