// {{{ 5 "SetRelativePositionForLabwareID" "Begin"
function SetRelativePositionForLabwareID( device & Instrument, variable i_strLabwareID, variable i_fltPositionX, variable i_fltPositionY, variable i_fltPositionZ, variable i_fltPositionR ) void {
// }} ""
// {{ 5 "SetRelativePositionForLabwareID" "InitLocals"
// }} ""
{
    // HxPars keys
    static string P_XCOORD("Labwr_XCoord");
    static string P_YCOORD("Labwr_YCoord");
    static string P_ZCOORD("Labwr_ZCoord");
    static string P_RZCOORD("Labwr_Rotation");
    static string P_LABWARE_ID("Labwr_Id");

    {
      variable PosVals[];
      variable myValue;
      object   objDecklayout;
      variable strFunctionName("");

      objDecklayout = Instrument.GetDeckLayoutObject();
   
      if(!objDecklayout.IsNull())
      {
        object objLabware;
        variable strPos("");

        onerror goto HandleLabwareError;
        objLabware = objDecklayout.Labware(i_strLabwareID);
        onerror goto 0;
        err.Clear();

        if(!objLabware.IsNull())
        {
          object Decklayout5;
          object MoveParameters;
          variable fltPos, fltPosShift, blnSuccess;

          objDecklayout.GetObject("IDeckLayout5", Decklayout5);

          MoveParameters.CreateObject("HXPARAMSLib.HxPars");
          MoveParameters.Add(i_strLabwareID, P_LABWARE_ID);

          Instrument.GetLabwarePosition(i_strLabwareID, PosVals);

          fltPos = HSLExtensions::Core::ConvertToFloat(PosVals[0],blnSuccess);
          fltPosShift = HSLExtensions::Core::ConvertToFloat(i_fltPositionX,blnSuccess);
          MoveParameters.Add(fltPos+fltPosShift, P_XCOORD);

          fltPos = HSLExtensions::Core::ConvertToFloat(PosVals[1],blnSuccess);
          fltPosShift = HSLExtensions::Core::ConvertToFloat(i_fltPositionY,blnSuccess);
          MoveParameters.Add(fltPos+fltPosShift, P_YCOORD);

          fltPos = HSLExtensions::Core::ConvertToFloat(PosVals[2],blnSuccess);
          fltPosShift = HSLExtensions::Core::ConvertToFloat(i_fltPositionZ,blnSuccess);
          MoveParameters.Add(fltPos+fltPosShift, P_ZCOORD);

          fltPos = HSLExtensions::Core::ConvertToFloat(PosVals[3],blnSuccess);
          fltPosShift = HSLExtensions::Core::ConvertToFloat(i_fltPositionR,blnSuccess);
          MoveParameters.Add(fltPos+fltPosShift, P_RZCOORD);

          Decklayout5.MoveLabware(objLabware, MoveParameters);

          Instrument.GetLabwarePosition(i_strLabwareID, PosVals);

          objLabware.ReleaseObject();
          objDecklayout.ReleaseObject();
          Decklayout5.ReleaseObject();
          MoveParameters.ReleaseObject();
        }
        else
        {
          objDecklayout.ReleaseObject();

        }
      }
      else
      {

      }

      HandleLabwareError :
      {
        variable errorID;
        errorID=err.GetId();
        err.Clear();

        if (errorID==-1574764487)
        {
          Trace("LabwareID is  unknown.");

        }
        else
        {

        }
      }
    }
}
// {{{ 5 "SetRelativePositionForLabwareID" "End"
}
// }} ""
