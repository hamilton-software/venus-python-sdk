objRackDataParams.CreateObject("HXPARAMSLib.HxPars");
objDecklayout = ML_STAR.GetDeckLayoutObject();
objLabware = objDecklayout.Labware(l_strLabwareName);

objLabware.GetObject("IRectRack4", objRack4);

