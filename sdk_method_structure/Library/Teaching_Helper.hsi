// {{{ 5 "GetLabwareDimensions" "Begin"
function GetLabwareDimensions( device & ML_STAR, variable i_strLabID, variable i_strWell, variable & o_fltRackHeight, variable & o_fltRackBase, variable & o_fltCenterX, variable & o_fltCenterY, variable & o_fltContainerDepth ) void {
// }} ""
private variable l_fltYOrigin;
private variable l_fltZOrigin;
private variable l_fltYWidth;
private variable l_fltXWidth;
private variable l_fltXOrigin;
// {{ 5 "GetLabwareDimensions" "InitLocals"
o_fltRackHeight = 0;
o_fltRackBase = 0;
o_fltCenterX = 0;
o_fltCenterY = 0;
o_fltContainerDepth = 0;
// }} ""
// {{ 248 1 0 "d5825872_b694_482f_92ffcedb27b20b37" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltXOrigin = 0.0;
// }} ""
// {{ 249 1 0 "2cdbe8ae_ef5e_467d_aa2688d63e0c631d" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltYOrigin = 0.0;
// }} ""
// {{ 250 1 0 "e9047b56_a4be_43f6_acff5e03c3a9f636" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltZOrigin = 0.0;
// }} ""
// {{ 251 1 0 "74fa33f4_bf85_452e_bcc4114604dcd5a7" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltXWidth = 0.0;
// }} ""
// {{ 252 1 0 "1f3d782c_8c18_4c70_a9077b0d81c180f9" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltYWidth = 0.0;
// }} ""
{
object objRackDataParams;
object objDecklayout;
object objLabware;
object objRack4;
object objRack;
object objCtr;

objRackDataParams.CreateObject("HXPARAMSLib.HxPars");
objDecklayout = ML_STAR.GetDeckLayoutObject();
objLabware = objDecklayout.Labware(i_strLabID);

objLabware.GetObject("IRectRack4", objRack4);
objLabware.GetObject2("{3E5213CF-57C9-4911-B33E-05E77130E4DB}", objRack); //  IEditLabware6
objRack.CntrAtPosition(objCtr,i_strWell);

objRack4.GetRackData(objRackDataParams);
l_fltXOrigin = objRackDataParams.Item1("Labwr_Bndry1X");
l_fltYOrigin = objRackDataParams.Item1("Labwr_Bndry1Y");
l_fltXWidth = objRackDataParams.Item1("Labwr_XDim")/2;
l_fltYWidth = objRackDataParams.Item1("Labwr_YDim")/2;
o_fltRackHeight = objRackDataParams.Item1("Labwr_ZDim");
l_fltZOrigin = objRack4.RackBase();
o_fltContainerDepth = objCtr.Depth;


objRackDataParams.ReleaseObject();
objDecklayout.ReleaseObject();
objLabware.ReleaseObject();
objRack4.ReleaseObject();
}
// {{ 254 1 0 "de9bac8b_fcef_43a8_b7fb261ef764f86c" "{B31F3544-5D80-11d4-A5EB-0050DA737D89}"
o_fltCenterX = l_fltXOrigin + l_fltXWidth;
// }} ""
// {{ 255 1 0 "1dbed561_8cd2_4686_ad546fb3dce2fe9a" "{B31F3544-5D80-11d4-A5EB-0050DA737D89}"
o_fltCenterY = l_fltYOrigin + l_fltYWidth;
// }} ""
// {{{ 256 1 0 "e45aa11a_67b1_4a73_81e4aa7e49d8af5a" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
o_fltRackBase = MthRound(l_fltZOrigin, 1);
// }} ""
// {{{ 5 "GetLabwareDimensions" "End"
}
// }} ""
