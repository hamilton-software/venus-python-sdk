// {{ 276 1 0 "e20407c0_b043_4288_aba1a41b82949023" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (l_intTipType == 10)
{
// }} ""
// {{ 277 1 0 "647689fd_868a_4289_ba1ef9141dfe1af6" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_intTotalRows = 8;
