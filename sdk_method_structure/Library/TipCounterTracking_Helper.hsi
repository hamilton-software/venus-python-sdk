// {{{ 5 "_ForkTipCounterInit" "Begin"
private function _ForkTipCounterInit(  ) void {
// }} ""
// {{ 5 "_ForkTipCounterInit" "InitLocals"
// }} ""
{
   device ML_STAR("","",hslTrue);
   ML_STAR = GetDeviceRef(SDK::DeckLayout,"ML_STAR");
   _ForkTipCounterInitDevice(ML_STAR);
}
// {{ 757 1 0 "c89023c9_d97b_4ef9_8e7a9ce1717f73a7" "{90ADC087-865A-4b6c-A658-A0F3AE1E29C4}"
if( 0 == t_eventWaitFor.SetEvent() )
{
    MECC::RaiseRuntimeErrorEx(-1557266176, MECC::IDS::stepNameSetEvent, MECC::IDS::errorStepFailed, "", "HxMetEdCompCmd");
}
// }} ""
// {{{ 5 "_ForkTipCounterInit" "End"
}
