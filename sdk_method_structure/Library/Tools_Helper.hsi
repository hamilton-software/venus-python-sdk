// {{{ 5 "GetContainerFile" "Begin"
function GetContainerFile( device & Device, variable i_strLabware, variable i_strWell, variable & o_strContainerFile ) void {
// }} ""
// {{ 5 "GetContainerFile" "InitLocals"
o_strContainerFile = 0;
// }} ""
// {{ 1818 1 0 "d2547e56_5a27_48bb_af0a791260cef9c9" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
o_strContainerFile = Translate("");
// }} ""
{
object rack;
object ctr;
object labware;
object m_decklayout;		
variable labwareId;

m_decklayout = Device.GetDeckLayoutObject();
labware = m_decklayout.Labware(i_strLabware);
labware.GetObject2("{3E5213CF-57C9-4911-B33E-05E77130E4DB}", rack); //  IEditLabware6

rack.CntrAtPosition(ctr,i_strWell);
o_strContainerFile = ctr.FileName;

rack.ReleaseObject(); 
ctr.ReleaseObject(); 
labware.ReleaseObject(); 
m_decklayout.ReleaseObject(); 
}

// {{{ 5 "GetContainerFile" "End"
}
