// {{{ 5 "GenerateLabwareName" "Begin"
function GenerateLabwareName( device & Device, variable i_strFilePath ) variable {
// }} ""
private variable l_strIteration;
private variable l_strFileName;
private variable l_strLabwareName;
private variable l_strSuffix;
private variable l_intIndex;
private variable l_blnLabwareFound;
// {{ 5 "GenerateLabwareName" "InitLocals"
// }} ""
// {{{ 968 1 0 "190eb27e_8148_43d8_80d68135c6e8319c" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strFileName = HSLExtensions::File::GetFileNameWithoutExtension(i_strFilePath);
// }} ""
// {{ 969 1 0 "d13120db_9680_4778_b82981898c3ea4d0" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_blnLabwareFound = ASWGLOBAL::BOOL::TRUE;
// }} ""
// {{ 970 1 0 "1224e590_2258_4dfd_b2cc54dd3d234f26" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
l_intIndex = 0;
while (l_blnLabwareFound == ASWGLOBAL::BOOL::TRUE)
{
l_intIndex = l_intIndex + 1;
// }} ""
// {{{ 971 1 0 "52d66059_be0b_414c_94c076d10419c512" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strIteration = StrConcat2(l_intIndex, Translate(""));
// }} ""
// {{{ 972 1 0 "82a5fe70_221a_409e_8626e8e5e6f070c5" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strSuffix = StrFillLeft(l_strIteration, Translate("0"), 4);
// }} ""
// {{{ 973 1 0 "ce7cc901_b5f3_4d7a_88ce56ed22087629" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strLabwareName = StrConcat4(l_strFileName, Translate("_"), l_strSuffix, Translate(""));
// }} ""
// {{{ 974 1 0 "3bec797c_8fab_413e_879ae375ef81dd2b" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strLabwareName = StrMakeLower(l_strLabwareName);
// }} ""
// {{{ 975 1 0 "551cdd6c_b1f7_4fa2_8aefc65b3ff8bdd0" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_blnLabwareFound = DevIsValidLabwareForCurrentDeckLayout(Device, l_strLabwareName);
// }} ""
// {{ 976 1 0 "1224e590_2258_4dfd_b2cc54dd3d234f26" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
}
}
// }} ""
// {{{ 977 1 0 "c65a163d_38b3_4da9_97bdb49e58c8ce6a" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (l_strLabwareName);
// }} ""
// {{{ 5 "GenerateLabwareName" "End"
}
