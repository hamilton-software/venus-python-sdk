// {{{ 5 "MoveLabware" "Begin"
function MoveLabware( device & Device, variable i_strLabware, variable i_strCarrier, variable i_strSite ) void {
// }} ""
// {{ 5 "MoveLabware" "InitLocals"
// }} ""
{

object objLayout;
object objLabware;
object objCarrier;
object objEditDeckLayout;

objLayout = Device.GetDeckLayoutObject();

if(!objLayout.IsNull())
{
   objCarrier = objLayout.Labware(i_strCarrier);
   objCarrier.GetObject("ITemplate", objEditDeckLayout);
   objEditDeckLayout.MoveLabware(i_strLabware,i_strSite);
}

objLayout.ReleaseObject();
objLabware.ReleaseObject();
objEditDeckLayout.ReleaseObject();
objCarrier.ReleaseObject();

}
// {{{ 5 "MoveLabware" "End"
}
