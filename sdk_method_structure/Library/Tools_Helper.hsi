// {{{ 5 "GetLabwareOrigin" "Begin"
function GetLabwareOrigin( device & Instrument, variable i_strLabwareID, variable & o_fltXCoord, variable & o_fltYCoord, variable & o_fltZCoord ) void {
// }} ""
private variable l_strExtension;
private variable l_fltA;
private variable l_strConfigFile;
// {{ 5 "GetLabwareOrigin" "InitLocals"
o_fltXCoord = 0;
o_fltYCoord = 0;
o_fltZCoord = 0;
// }} ""
// {{ 2078 1 0 "07911430_8dad_4e5a_ac1ca2edc50b0ff1" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
o_fltXCoord = 0.0;
// }} ""
// {{ 2079 1 0 "88698437_cb73_4040_b800a8f853639dce" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
o_fltYCoord = 0.0;
// }} ""
// {{ 2080 1 0 "265c2bea_30e6_4f3c_a6254925b7f434a9" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
o_fltZCoord = 0.0;
// }} ""
// {{{ 2081 1 0 "c0ab9db3_d42f_473f_a482022b7faa3232" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
HSLLabwrAccess::GetConfigurationFilename(Instrument, i_strLabwareID, l_strConfigFile);
// }} ""
// {{{ 2082 1 0 "765ceab1_ce5d_48cb_aef6abc2b9a06185" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strExtension = HSLExtensions::File::GetFileExtension(l_strConfigFile);
// }} ""
// {{ 2083 1 0 "8781ba18_3f6d_41d9_8a1f25af34ae00cc" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (l_strExtension == "rck")
{
// }} ""
{
object objRackDataParams;
object objDecklayout;
object objLabware;
object objRack4;

onerror goto HandleLabwareError;

objRackDataParams.CreateObject("HXPARAMSLib.HxPars");
objDecklayout = Instrument.GetDeckLayoutObject();
objLabware = objDecklayout.Labware(i_strLabwareID);

objLabware.GetObject("IRectRack4", objRack4);

objRack4.GetRackData(objRackDataParams);
o_fltXCoord = objRackDataParams.Item1("Labwr_Bndry1X");
o_fltYCoord = objRackDataParams.Item1("Labwr_Bndry1Y");
o_fltZCoord = objRack4.RackBase();

HandleLabwareError : {}

objRackDataParams.ReleaseObject();
objDecklayout.ReleaseObject();
objLabware.ReleaseObject();
objRack4.ReleaseObject();
}
// {{ 2085 1 0 "8781ba18_3f6d_41d9_8a1f25af34ae00cc" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
else
{
// }} ""
// {{{ 2086 1 0 "56c3de76_6c40_4872_a97d371fa559256e" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
DevGetLabwarePosition(Instrument, i_strLabwareID, o_fltXCoord, o_fltYCoord, o_fltZCoord, l_fltA);
// }} ""
// {{ 2087 1 0 "8781ba18_3f6d_41d9_8a1f25af34ae00cc" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{{ 5 "GetLabwareOrigin" "End"
}
