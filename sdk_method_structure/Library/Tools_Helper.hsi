// {{{ 5 "LabwareTransportOffsetNoContainer" "Begin"
function LabwareTransportOffsetNoContainer( device & Device, variable i_strLabware ) variable {
// }} ""
private variable l_strPosID;
private variable l_fltYCoord;
private variable l_fltZBottom;
private variable l_fltXCoord;
private variable l_fltACoord;
private variable l_fltZOffset;
private sequence l_seqPosition;
// {{ 5 "LabwareTransportOffsetNoContainer" "InitLocals"
// }} ""
// {{ 2593 1 0 "dced2cc8_5744_48b2_87a00978828a35de" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltZOffset = 0.0;
// }} ""
// {{{ 2594 1 0 "e86a311b_b36e_4c22_ac45035c93bb6c90" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
HSLLabwrAccess::GetTransportSequenceForLabwareID(Device, i_strLabware, l_seqPosition);
// }} ""
// {{{ 2595 1 0 "0a92888a_9403_428f_8e0dc9ff6344e49a" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strPosID = SeqGetPositionId(l_seqPosition);
// }} ""
// {{{ 2596 1 0 "79266a1e_eba2_4183_91906b3667bafc4e" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
DevGetLabwarePositionEx(Device, i_strLabware, l_strPosID, l_fltXCoord, l_fltYCoord, l_fltZBottom, l_fltACoord);
// }} ""
{
object rack;
object labware;
object layout;
object rckParams;
object rck4;

variable height;
variable rackBase;
variable topCoord;

onerror goto HandleLabwareError;

rckParams.CreateObject("HXPARAMSLib.HxPars");
layout = Device.GetDeckLayoutObject();
labware = layout.Labware(i_strLabware);
labware.GetObject2("{3E5213CF-57C9-4911-B33E-05E77130E4DB}", rack);
labware.GetObject("IRectRack4", rck4);

rck4.GetRackData(rckParams);
height = rckParams.Item1("Labwr_ZDim");
rackBase = rck4.RackBase();

onerror goto 0;
err.Clear();

topCoord = l_fltZBottom + height;
l_fltZOffset = topCoord - rackBase;

HandleLabwareError :{}

rack.ReleaseObject();
labware.ReleaseObject();
layout.ReleaseObject();
rckParams.ReleaseObject();
rck4.ReleaseObject();
}
// {{{ 2598 1 0 "3275ef4e_4d13_426f_827fe9a7621f3c2c" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (l_fltZOffset);
// }} ""
// {{{ 5 "LabwareTransportOffsetNoContainer" "End"
}
