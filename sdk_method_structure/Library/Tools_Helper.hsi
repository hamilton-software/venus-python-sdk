// {{{ 5 "LabwareTransportOffset" "Begin"
function LabwareTransportOffset( device & Device, variable i_strLabware ) variable {
// }} ""
private variable l_fltZOffset;
private variable l_strPosID;
private sequence l_seqPosition;
private variable l_fltYCoord;
private variable l_fltZBottom;
private variable l_fltXCoord;
private variable l_fltACoord;
// {{ 5 "LabwareTransportOffset" "InitLocals"
// }} ""
// {{ 2586 1 0 "46d05f39_54ef_4f08_a6d35758ada4c8fb" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_fltZOffset = 0.0;
// }} ""
// {{{ 2587 1 0 "629bb9cb_fcf4_4a6c_b1329eee73743178" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
HSLLabwrAccess::GetTransportSequenceForLabwareID(Device, i_strLabware, l_seqPosition);
// }} ""
// {{{ 2588 1 0 "70a9c23e_e562_44d7_ba5bb113d0c36afe" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strPosID = SeqGetPositionId(l_seqPosition);
// }} ""
// {{{ 2589 1 0 "c434a404_d955_4123_b48aab4e35c829e8" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
DevGetLabwarePositionEx(Device, i_strLabware, l_strPosID, l_fltXCoord, l_fltYCoord, l_fltZBottom, l_fltACoord);
// }} ""
{
object rack;
object ctr;
object labware;
object layout;
object rckParams;
object rck4;

variable depth;
variable rackBase;
variable topCoord;

onerror goto HandleLabwareError;

rckParams.CreateObject("HXPARAMSLib.HxPars");
layout = Device.GetDeckLayoutObject();
labware = layout.Labware(i_strLabware);
labware.GetObject2("{3E5213CF-57C9-4911-B33E-05E77130E4DB}", rack);
labware.GetObject("IRectRack4", rck4);

rck4.GetRackData(rckParams);
rackBase = rck4.RackBase();

rack.CntrAtPosition(ctr,l_strPosID);

onerror goto 0;
err.Clear();

depth = ctr.Depth;
topCoord = l_fltZBottom + depth;
l_fltZOffset = topCoord - rackBase;

HandleLabwareError :{}

rack.ReleaseObject();
ctr.ReleaseObject();
labware.ReleaseObject();
layout.ReleaseObject();
rckParams.ReleaseObject();
rck4.ReleaseObject();
}
// {{{ 2591 1 0 "c3428495_a8f8_4e23_88d77e9c9adaf314" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (l_fltZOffset);
// }} ""
// {{{ 5 "LabwareTransportOffset" "End"
}
// }} ""
// {{{ 5 "MoveLabwareToDeckSite" "Begin"
function MoveLabwareToDeckSite( device & Device, variable i_strLabware, variable i_strCarrier, variable i_strSite ) void {
// }} ""
private variable l_blnUseSecondSite;
private variable l_strSecondSite;
private variable l_strActiveCarrier;
private variable l_strSecondCarrier;
private variable l_strActiveSite;
// {{ 5 "MoveLabwareToDeckSite" "InitLocals"
// }} ""
// {{{ 2946 1 0 "c497da00_a93c_41a1_83efaa649e4525f0" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
l_blnUseSecondSite = LayoutTracking::CheckSite(i_strCarrier, i_strSite, l_strSecondCarrier, l_strSecondSite);
// }} ""
// {{ 2947 1 0 "9cd1e1e7_7a40_496e_aa6b3776a0c6d615" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strActiveCarrier = i_strCarrier;
// }} ""
// {{ 2948 1 0 "33d6ac5e_f095_467f_8319a961a3f1d100" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strActiveSite = i_strSite;
// }} ""
// {{ 2949 1 0 "f6896778_ef56_4a55_9f61b8db3ad238c3" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (l_blnUseSecondSite == ASWGLOBAL::BOOL::TRUE)
{
// }} ""
// {{ 2950 1 0 "f61c4bed_83a9_47f5_a62c1f1cb7d039a4" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strActiveCarrier = l_strSecondCarrier;
// }} ""
// {{ 2951 1 0 "b04a797f_3af5_4a5f_b3e322b95fd7eb27" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strActiveSite = l_strSecondSite;
// }} ""
// {{ 2952 1 0 "f6896778_ef56_4a55_9f61b8db3ad238c3" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
{

object objLayout;
object objLabware;
object objEditDeckLayout;

objLayout = Device.GetDeckLayoutObject();

if(!objLayout.IsNull())
{
   objLayout.GetObject("IEditDeckLayout6", objEditDeckLayout);
   objLabware = objLayout.Labware(i_strLabware);
   objEditDeckLayout.MoveLabwareToDeckSite(objLabware, l_strActiveCarrier,l_strActiveSite);
}

objLayout.ReleaseObject();
objLabware.ReleaseObject();
objEditDeckLayout.ReleaseObject();

}
// {{{ 2954 1 0 "d0cba42a_e350_4b2f_838757191687f289" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
TaughtLocation_Helper::ShiftLabwareForTaughtLocation(Device, i_strLabware, i_strCarrier, i_strSite);
// }} ""
// {{{ 5 "MoveLabwareToDeckSite" "End"
}
