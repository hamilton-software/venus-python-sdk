   l_strVANTAGEComTracePath = GetLogFilesPath() + "\\" + "HxTcpIpBdzComm" + l_strDate + ".trc";
   l_strSIMComTracePath = GetLogFilesPath() + "\\" + "ComTrace_Simulator" + l_strDate + ".trc";

   objFSO.ReleaseObject();
}
