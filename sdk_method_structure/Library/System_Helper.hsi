// {{{ 5 "GetTrackInfo" "Begin"
function GetTrackInfo( variable & o_intMaxTrack, variable & o_intMaxLoadTrack ) void {
// }} ""
private variable l_strInstrumentConfigFile;
// {{ 5 "GetTrackInfo" "InitLocals"
o_intMaxTrack = 0;
o_intMaxLoadTrack = 0;
// }} ""
// {{ 277 1 0 "220a5518_82e1_4d84_a0c34ece8ef3ee9a" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strInstrumentConfigFile = Translate("");
// }} ""
{
   object   objHxRegistry;
   variable strConfigName("");
   variable strInstrumentClass;
   variable strInstrument;
   variable i_intFileType(1);

   onerror goto ErrorHandler;

   objHxRegistry.CreateObject("HXREGLib.HxRegistry.1");

   strInstrument = "ML_STAR";

   strInstrumentClass = objHxRegistry.InstClass(strInstrument);
   if(i_intFileType == 0) objHxRegistry.InstCfgFile(strInstrument, strConfigName);
   if(i_intFileType == 1) objHxRegistry.InstDeckCfgFile(strInstrument, strConfigName);
   if(i_intFileType == 2) objHxRegistry.InstDeckTplFile(strInstrument, strConfigName);

   l_strInstrumentConfigFile = GetConfigPath() + "\\" + strConfigName;
   //Trace("Config File:  ",l_strInstrumentConfigFile);

   objHxRegistry.ReleaseObject();

   ErrorHandler:
   {
      objHxRegistry.ReleaseObject();
   }

}
