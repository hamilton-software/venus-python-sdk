// }} ""
{
   object   objHxRegistry;
   variable strConfigName("");
   variable strInstrumentClass;
   variable strInstrument;
   variable i_intFileType(0);

   onerror goto ErrorHandler;

   objHxRegistry.CreateObject("HXREGLib.HxRegistry.1");

   strInstrument = "ML_STAR";

   strInstrumentClass = objHxRegistry.InstClass(strInstrument);
   if(i_intFileType == 0) objHxRegistry.InstCfgFile(strInstrument, l_strInstrumentType);
   if(i_intFileType == 1) objHxRegistry.InstDeckCfgFile(strInstrument, l_strInstrumentType);
   if(i_intFileType == 2) objHxRegistry.InstDeckTplFile(strInstrument, l_strInstrumentType);

   objHxRegistry.ReleaseObject();

   ErrorHandler:
   {
      objHxRegistry.ReleaseObject();
   }

}
