{
   object objFSO;

   objFSO.CreateObject("Scripting.FileSystemObject");

   l_strLogFilePath = GetLogFilesPath() + "\\" + objFSO.GetBaseName(GetMethodFileName()) + "_" + GetUniqueRunId() + "_Trace.trc";
   l_strTADMDataPath = GetLogFilesPath() + "\\" + objFSO.GetBaseName(GetMethodFileName()) + "_" + GetUniqueRunId() + "_ML_STAR_tadm.mdb";
