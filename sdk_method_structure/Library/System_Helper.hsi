}
else
{
// }} ""
// {{{ 199 1 0 "23722a13_be25_494b_ac045a0b9ef60006" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (ASWGLOBAL::BOOL::TRUE);
// }} ""
