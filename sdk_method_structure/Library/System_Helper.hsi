// {{{ 5 "GetMaintenanceDeck" "Begin"
function GetMaintenanceDeck(  ) variable {
// }} ""
private variable l_strInstrumentConfigFile;
private variable l_blnIsSTARLine;
private variable l_intMaxLoadTrack;
private variable l_intMaxTrack;
private variable l_strFileName;
private variable l_blnModExists;
private variable l_strDirectory;
private variable l_strExtension;
private variable l_strModCheck;
// {{ 5 "GetMaintenanceDeck" "InitLocals"
// }} ""
// {{ 156 1 0 "9ecc6bd4_d756_4500_85682658dde9ddec" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
l_strInstrumentConfigFile = Translate("");
// }} ""
// {{{ 157 1 0 "44db88de_8c9a_43a3_afe6db10dfe94f54" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
l_blnIsSTARLine = IsSTARLine();
// }} ""
// {{{ 158 1 0 "4054ca53_5004_44a9_8ae5d6010370607c" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
GetTrackInfo(l_intMaxTrack, l_intMaxLoadTrack);
// }} ""
{
   object   objHxRegistry;
   variable strConfigName("");
   variable strInstrumentClass;
   variable strInstrument;
   variable i_intFileType(2);

   if(l_blnIsSTARLine)
   {
      if(l_intMaxLoadTrack == 54) strConfigName = "StarLineMaintenance_STAR.lay";
      else if(l_intMaxLoadTrack == l_intMaxTrack) strConfigName = "StarLineMaintenance_Starlet.lay";
      else strConfigName = "StarLineMaintenance_StarPlus.lay";
   }
   else
   {
      strConfigName = "Maintenance_VOV.lay";
   }

   l_strInstrumentConfigFile = GetMethodsPath() + "\\VM\\" + strConfigName;

   Trace("Config File:  ",l_strInstrumentConfigFile);

}
// {{{ 160 1 0 "8c3050c6_d08a_44ce_bd72b15425ce71d5" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strDirectory = HSLExtensions::File::GetDirectoryName(l_strInstrumentConfigFile);
// }} ""
// {{{ 161 1 0 "42a56a57_9353_4932_8a2202deb45be0e1" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strFileName = HSLExtensions::File::GetFileNameWithoutExtension(l_strInstrumentConfigFile);
// }} ""
// {{{ 162 1 0 "c5c8accc_72e1_4753_89c2eb03f50aa518" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strExtension = HSLExtensions::File::GetFileExtension(l_strInstrumentConfigFile);
// }} ""
// {{{ 163 1 0 "3cc037d5_cc33_4181_a09a60f9652937bd" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_strModCheck = StrConcat8(l_strDirectory, Translate("\\"), l_strFileName, Translate("_mod"), Translate("."), l_strExtension, Translate(""), Translate(""));
// }} ""
// {{{ 164 1 0 "03c41c69_f4dd_456b_b9bd731347d4587f" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
l_blnModExists = HSLExtensions::File::Exists(l_strModCheck);
// }} ""
// {{ 165 1 0 "adf60da4_9af3_4543_a37087617970b357" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (l_blnModExists == ASWGLOBAL::BOOL::TRUE)
{
// }} ""
// {{{ 166 1 0 "6566e343_f85a_436b_88b93bf54135d88b" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (l_strModCheck);
// }} ""
// {{ 167 1 0 "adf60da4_9af3_4543_a37087617970b357" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{{ 168 1 0 "898ed0d8_708c_4c4d_8f9e552da6fdd4e9" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (l_strInstrumentConfigFile);
// }} ""
// {{{ 5 "GetMaintenanceDeck" "End"
}
