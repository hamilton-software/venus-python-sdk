// {{{ 5 "IsSTARLine" "Begin"
function IsSTARLine(  ) variable {
// }} ""
private variable l_strInstrumentConfigFile;
private variable l_strInstrumentType;
// {{ 5 "IsSTARLine" "InitLocals"
