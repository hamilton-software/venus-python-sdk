// {{ 201 1 0 "48dd2ae0_a522_415b_9d0249c08cd056d7" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
{
   object objFSO;
   object objTraceFile;
   variable strTraceFile(l_strTraceFile);
   variable intSNFound;

   //Trace(strTraceFile);   

   objFSO.CreateObject("Scripting.FileSystemObject");

   objTraceFile = objFSO.OpenTextFile(strTraceFile , 1);
   //l_strFileContent = objTraceFile.ReadAll();

   while(!objTraceFile.AtEndOfLine)
   {
      l_strFileContent = objTraceFile.ReadLine;
      intSNFound = StrReplace(l_strFileContent,"sn","sn");
      if(intSNFound > 0) break;
   }
   objTraceFile.Close;

   objFSO.ReleaseObject();
   objTraceFile.ReleaseObject();
}
