# Use native line endings for text files
*.json text
*.cfg text
*.md text
*.yml text
*.yaml text
# Automatically handle line endings for all text files
* text=auto
# Python source
*.py text
*.pyi text
# Config / data files
*.toml text
*.yaml text
*.yml  text
*.json text
*.ini  text
*.cfg  text
*.txt  text
*.md   text
*.rst  text
# Shell scripts — always LF regardless of OS
*.sh   text eol=lf
# Windows scripts — always CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
# Binary — never diff or mangle line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.whl  binary
# Tell git-diff to use Python syntax highlighting for .pyi stub files
*.pyi  diff=python
# Exclude from `git archive` exports (e.g. sdist tarballs on PyPI)
.gitattributes      export-ignore
.gitignore          export-ignore
.azure/             export-ignore
.github/            export-ignore
tests/              export-ignore
docs/               export-ignore
examples/           export-ignore
CONTRIBUTING.md     export-ignore
SECURITY.md         export-ignore
CHANGELOG.md        export-ignore
*.exe filter=lfs diff=lfs merge=lfs -text
*.msi filter=lfs diff=lfs merge=lfs -text
